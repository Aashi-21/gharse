# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL of the app (used for the cookie "Secure" flag and origin checks).
# Use https://your-domain in production.
APP_URL=http://localhost:5173

# TRUST_PROXY controls whether the app believes the X-Forwarded-For header when working out a visitor's IP
# (used by the rate limiter, including public checkout). Keep it false unless the app is REALLY behind a reverse
# proxy you control (Caddy/nginx/Apache/Passenger on your host) that overwrites that header.
#   - behind your proxy: true  (otherwise every visitor looks like the proxy's IP and shares one rate limit)
#   - directly exposed:  false (otherwise anyone can fake their IP and bypass the rate limit)
TRUST_PROXY=false

# PostgreSQL connection string. External hosts (Neon, Supabase) usually need ?sslmode=require
DATABASE_URL=postgresql://gharse:gharse@localhost:5432/gharse

# Used only by `npm test` — MUST point at a separate database whose name ends in _test
TEST_DATABASE_URL=postgresql://gharse:gharse@localhost:5432/gharse_test

SESSION_TTL_DAYS=14

# Public checkout limits
ORDER_RATE_LIMIT_MAX=10        # orders per minute per client IP
ORDER_PHONE_HOURLY_LIMIT=3     # orders per phone number per store per hour
ORDER_STORE_HOURLY_LIMIT=100   # orders per store per hour
AUTH_RATE_LIMIT_MAX=10

# Image storage. Only "local" exists so far (needs a persistent disk/volume).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Email (contact form + health check). Leave SMTP_HOST empty to disable: the contact form then answers
# "unavailable" and never claims a message was sent. There are no defaults for the SMTP host, user, password,
# sender or recipient: they come from your mailbox provider (not decided yet).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=

# Contact form abuse limits and delivery timeout
CONTACT_RATE_LIMIT_MAX=10      # requests per client IP per hour (invalid ones count too)
CONTACT_HOURLY_LIMIT=60        # messages per hour in total, across all visitors
CONTACT_SEND_TIMEOUT_MS=15000  # give up waiting for the mail server after this long

# Anthropic (backend only, never exposed to the browser)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
AI_TIMEOUT_MS=90000
# Retries of transient Claude API errors (429/5xx/network) inside the SDK
AI_MAX_RETRIES=2
# Per-seller caps on Claude calls (every attempt counts, including failures)
AI_HOURLY_LIMIT=20
AI_DAILY_LIMIT=100

# Seed: password for the SAMPLE seller account (random one is printed if empty)
SEED_SAMPLE_PASSWORD=
