{
  "name": "@gharse/server",
  "private": true,
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "node scripts/prisma.cjs",
    "seed": "tsx prisma/seed.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "e2e:brand-memory": "tsx scripts/e2e-brand-memory.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.0.0",
    "nodemailer": "^10.6.0",
    "prisma": "^6.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
